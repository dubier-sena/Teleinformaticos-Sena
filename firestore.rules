rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── Helpers ─────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // El cliente Firebase Auth firma con email sintetico
    // "{usernameKey}@sena-portal.local". Eso permite derivar el dueño
    // sin Custom Claims (que requeririan Cloud Functions / plan Blaze).
    function emailForUsername(usernameKey) {
      return usernameKey + "@sena-portal.local";
    }

    // Email versionado: cuando el admin resetea la password de un aprendiz,
    // el bridge crea una cuenta Auth nueva con email "{key}.v{N}@sena-portal.local"
    // (ver buildEmail en firebase_auth_bridge.js). La version N valida es la
    // ATESTADA por el admin en sena_portal_user_meta/{key}.authEmailVersion
    // (solo admin/dueno escriben ese doc). Sin este OR, un aprendiz reseteado
    // perdia TODA la propiedad de sus documentos (403 en cada lectura/escritura).
    function isOwnerByVersionedEmail(usernameKey) {
      return exists(/databases/$(database)/documents/sena_portal_user_meta/$(usernameKey))
        && request.auth.token.email == (
          usernameKey + ".v"
          + string(get(/databases/$(database)/documents/sena_portal_user_meta/$(usernameKey)).data.authEmailVersion)
          + "@sena-portal.local"
        );
    }

    function isOwnerByUsernameKey(usernameKey) {
      return signedIn()
        && (
          request.auth.token.email == emailForUsername(usernameKey)
          || isOwnerByVersionedEmail(usernameKey)
        );
    }

    // Documentos de guia con docId COMPUESTO en sena_portal_progress:
    //   "__guide_data__:student:{usernameKey}:{archivo}" (respuestas de guia)
    //   "__guide_ui__:student:{usernameKey}:{archivo}"   (estado de UI)
    // El docId completo NO es el usernameKey, asi que isOwnerByUsernameKey(docId)
    // jamas autorizaba al aprendiz (403 en TODOS sus guardados de respuestas;
    // solo el fallback a Drive los atrapaba y el admin, que lee Firestore,
    // no los veia). El dueno real es el segmento [2] del docId.
    //
    // OJO: el cliente SANEA el usernameKey al construir el docId (safeCloudKey
    // en firebase_db.js: todo lo que no sea [a-z0-9:_-] se vuelve "_"). Para
    // usuarios con punto (eimy.alvarez) el segmento queda "eimy_alvarez", asi
    // que ademas de la comparacion exacta se acepta la comparacion con el
    // email SANEADO igual. Riesgo CONFIRMADO (auditoria profunda): un usuario
    // llamado "eimy_alvarez" (con guion bajo real) colisiona de verdad con
    // "eimy.alvarez" -- ambos quedan autorizados sobre el MISMO docId. La
    // migracion a isOwnerOfComposedUidDoc (abajo) es la solucion real: los
    // docs NUEVOS usan el UID de Firebase (nunca ambiguo) en vez de este
    // segmento saneado. Esta funcion se conserva SOLO para leer/escribir los
    // docs LEGADOS ya existentes durante la transicion (ver
    // mergeLegacyAndUidGuideStateDocs en firebase_db.js) -- no se le agrega
    // logica nueva.
    //
    // PENDIENTE DE CONFIRMACION (auditoria profunda, no modificar sin
    // verificar primero): el patron '[^a-z0-9_-]' se pasa aqui como STRING a
    // .replace(), no como literal de regex -- sin acceso a un emulador de
    // Firestore en este entorno no se pudo confirmar si el motor de reglas
    // (1) lo trata como regex y reemplaza TODAS las coincidencias (como el
    // safeCloudKey del cliente, correcto), (2) lo trata como regex pero solo
    // reemplaza la PRIMERA coincidencia (un usuario con 2+ caracteres
    // especiales, p.ej. "ana.maria.lopez", quedaria bloqueado de su propio
    // docId compuesto), o (3) lo trata como substring LITERAL (nunca haria
    // match, el saneado seria un no-op). Estrategia de validacion concreta
    // (Firebase Console -> Firestore -> Rules -> Playground, sin instalar
    // nada): simular un `get` sobre
    // sena_portal_progress/__guide_data__:student:ana_maria_lopez:archivo
    // con auth.token.email = "ana.maria.lopez@sena-portal.local". Si el
    // resultado es "Deny", el caso (2) o (3) es real y hay que corregir esta
    // funcion; si es "Allow", queda descartado. Ver tambien
    // tests/firestore_rules_ownership.test.cjs (test.todo) para el recordatorio
    // permanente en la suite.
    function sanitizedTokenKey() {
      return request.auth.token.email.split('@')[0].replace('[^a-z0-9_-]', '_');
    }
    function isOwnerOfComposedStudentDoc(docId) {
      return docId.matches('^__guide_(data|ui)__:student:[^:]+:.+$')
        && (
          isOwnerByUsernameKey(docId.split(':')[2])
          || (signedIn() && docId.split(':')[2] == sanitizedTokenKey())
        );
    }

    // Fase 5 (auditoria profunda): esquema NUEVO de propiedad para
    // sena_portal_progress, keyed por UID de Firebase en vez de usernameKey
    // saneado. request.auth.uid nunca se sanea ni se deriva de texto libre,
    // asi que dos cuentas reales JAMAS pueden compartir el mismo docId por
    // este camino -- a diferencia de isOwnerOfComposedStudentDoc arriba.
    // Aditivo: no reemplaza la funcion anterior, solo se agrega con OR en las
    // reglas de sena_portal_progress y sena_portal_guide_state.
    function isOwnerOfComposedUidDoc(docId) {
      return docId.matches('^__guide_(data|ui)__:uid:[^:]+:.+$')
        && signedIn() && docId.split(':')[2] == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/sena_portal_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/sena_portal_roles/$(request.auth.uid)).data.role == "admin";
    }

    // Doc COMPARTIDO de fechas de entrega (activity_deadlines.js). Lo escribe
    // SOLO el admin, pero TODOS los aprendices deben poder LEERLO para saber
    // si una actividad esta cerrada — y sobre todo para enterarse cuando el
    // admin elimina o mueve la fecha. Sin esta lectura, la copia cacheada en
    // localStorage del aprendiz (con la fecha vieja) gana para siempre y la
    // guia queda bloqueada aunque el admin haya quitado la fecha.
    function isSharedDeadlinesDoc(docId) {
      return docId == "__guide_data__:admin:activity-deadlines:__activity_deadlines_v1";
    }

    // Lista documental de correos administradores permitidos para auditoria.
    // La autoridad real sigue siendo sena_portal_roles/{uid}; conservar este
    // helper evita que el contrato de seguridad pierda la referencia explicita.
    function adminEmails() {
      return ["dubier@sena-portal.local"];
    }

    // Devuelve la ficha del aprendiz solicitante leyendo el indice por uid
    // (sena_portal_user_index/{uid}). Se usa en la regla `list` de
    // sena_portal_users para limitar la consulta a la misma ficha sin tener
    // que parsear el email (que puede venir versionado: dubier.v2@...).
    function requesterFicha() {
      return get(/databases/$(database)/documents/sena_portal_user_index/$(request.auth.uid)).data.ficha;
    }

    // ───── Roles administrativos ───────────────────────────────────────────
    // Cualquier usuario autenticado puede leer SOLO su propio doc (para que
    // el cliente sepa si es admin tras login).
    // Bootstrap: el primer admin (dubier@sena-portal.local) puede CREAR su
    // propio doc role la primera vez. Despues, solo otro admin existente
    // puede modificar la coleccion.
    match /sena_portal_roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.auth.token.email == "dubier@sena-portal.local"
          && request.resource.data.role == "admin"
        );
      allow update, delete: if isAdmin();
    }

    // ───── Usuarios (perfil + metadatos del aprendiz) ──────────────────────
    // Lectura: cualquier sesion autenticada puede leer/listar user docs. El
    // doc cloud NO contiene passwordHash (se elimina en cloudSaveUser de
    // firebase_db.js), asi que solo expone nombre y ficha — necesario para
    // que un aprendiz pueda armar equipos de trabajo seleccionando a sus
    // companeros de la misma ficha (p. ej. Actividad 10 de Guia 2).
    // Escritura: solo admin o el propio aprendiz.
    match /sena_portal_users/{usernameKey} {
      // get (un doc puntual, Fase 7 -- auditoria profunda): antes cualquier
      // sesion autenticada podia leer el perfil COMPLETO (nombre + ficha) de
      // CUALQUIER otro aprendiz con solo conocer su usernameKey -- visible en
      // URLs/REST, sin pasar por "list" (que ya esta acotado a la misma
      // ficha, ver abajo). Los unicos usos reales de un GET puntual
      // (cloudGetUser en firebase_db.js: restaurar sesion en equipo nuevo,
      // fallback de login, reset de password) son siempre sobre EL PROPIO
      // usuario o iniciados por el admin; ninguno necesita el perfil de un
      // companero. Minimo privilegio: solo el dueno o el admin.
      allow get: if isOwnerByUsernameKey(usernameKey) || isAdmin();
      // list (query): admin ve todo; el aprendiz SOLO puede consultar SU ficha.
      // La consulta DEBE incluir where('ficha','==', suFicha) — sino,
      // resource.data.ficha != requesterFicha() para algun doc y la regla niega.
      // Asi un aprendiz no puede listar a aprendices de otra ficha.
      allow list: if isAdmin()
        || (signedIn() && resource.data.ficha == requesterFicha());
      allow create, update: if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow delete: if isAdmin();
    }

    // ───── Hash de contrasena del aprendiz ─────────────────────────────────
    // Coleccion paralela a sena_portal_users con visibilidad RESTRINGIDA:
    // solo el propio aprendiz (autenticado via Firebase Auth) o el admin
    // pueden leerla. Esto permite que el hash quede sincronizado en la nube
    // (para que el aprendiz pueda entrar desde otro dispositivo) sin
    // exponerlo a otros aprendices (que sí pueden leer sena_portal_users
    // para armar equipos de trabajo).
    // Estructura del doc: { usernameKey, passwordHash, updatedAt }
    match /sena_portal_user_auth/{usernameKey} {
      allow read: if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow create, update: if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow delete: if isAdmin();
    }

    // ───── Metadata publica del aprendiz (version de email Auth) ───────────
    // El bridge necesita conocer la version del email sintetico ANTES de
    // poder loguear al aprendiz en Firebase Auth (chicken-and-egg). Por eso
    // esta coleccion permite GET publico (sin requerir auth) pero NO permite
    // LIST. Cada doc expone solo { authEmailVersion } — no hay PII.
    // El versionado se incrementa cuando el admin resetea password desde el
    // panel (ver updateStudentPassword en firebase_db.js).
    match /sena_portal_user_meta/{usernameKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow delete: if isAdmin();
    }

    // ───── Codigo de invitacion por ficha (Fase 6) -- NO vive en Firestore ──
    // Version anterior de esta regla: `allow get: if true` sobre una
    // coleccion sena_portal_ficha_codes -- lectura PUBLICA, sin sesion.
    // Hallazgo real (auditoria profunda, revision posterior): eso significaba
    // que CUALQUIERA que conociera una ficha podia leer el codigo REAL por
    // Firestore REST sin autenticarse -- el codigo nunca fue secreto. No
    // existe una forma de que este mismo esquema (Firestore + lectura previa
    // al login) sea seguro sin exponer el valor a comparar. Corregido
    // migrando la verificacion completa a Apps Script (entregas_actividades.gs,
    // acciones "verifyRegistrationCode"/"setRegistrationCode"): el codigo se
    // compara server-side contra un hash en Script Properties y el cliente
    // NUNCA recibe ni el codigo ni un hash reutilizable, solo valido/no-valido.
    // Sin match aqui, esta coleccion cae al cierre total del final de este
    // archivo (`allow read, write: if false`) -- ademas, nada en el cliente
    // ya la referencia.

    // ───── Indice uid -> ficha (para regla list de sena_portal_users) ──────
    // Solo el propio aprendiz (autenticado en Firebase Auth) o el admin
    // pueden leer/escribir su indice. El doc expone solo { ficha, updatedAt }.
    // El cliente lo escribe en cada login exitoso (ver portal_auth.js).
    match /sena_portal_user_index/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ───── Resumen remoto del aprendiz (Fase 11 - Home cross-device) ───────
    // Documento DERIVADO y liviano, calculado por el propio navegador del
    // aprendiz a partir de datos que el ya puede leer legitimamente (notas,
    // talleres de refuerzo, firma, documentos base de Etapa Productiva,
    // progreso local de guias). NUNCA es la fuente de verdad de nada: las
    // respuestas siguen en sena_portal_guide_state, las notas oficiales en
    // sena_portal_grades, las entregas en Drive. Mismo modelo de confianza que
    // ya describe CLAUDE.md para datos client-owned (ver "Trust model"): si un
    // aprendiz alterara su propio resumen, solo confundiria su propio Home, sin
    // afectar ningun dato autoritativo ni a otro aprendiz.
    // Clave = uid de Firebase (no usernameKey), como toda coleccion nueva desde
    // la Fase 5. request.auth.uid == uid es ademas lo que impide que un
    // aprendiz pueda LISTAR el resumen de otro: una consulta `list` sin filtro
    // no puede probarse valida para todo el set (excepto admin), exactamente
    // igual que ya protege sena_portal_user_index arriba.
    match /sena_portal_student_summary/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && (request.auth.uid == uid || isAdmin())
        && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    // ───── Progreso por aprendiz ───────────────────────────────────────────
    // {usernameKey} puede ser: (a) la clave simple del aprendiz (doc de % de
    // progreso), o (b) un docId COMPUESTO "__guide_data__/__guide_ui__:student:
    // {key}:{archivo}" donde guarda sus respuestas/estado de guia (ver
    // guideStateDocId en firebase_db.js). El caso (b) se autoriza por el
    // segmento del docId con isOwnerOfComposedStudentDoc.
    match /sena_portal_progress/{usernameKey} {
      // Fechas de entrega: lectura compartida (escritura sigue solo-admin,
      // porque este docId nunca coincide con la propiedad del aprendiz).
      allow get: if signedIn() && isSharedDeadlinesDoc(usernameKey);
      allow read, write: if isAdmin()
        || isOwnerByUsernameKey(usernameKey)
        || isOwnerOfComposedStudentDoc(usernameKey)
        || isOwnerOfComposedUidDoc(usernameKey);
    }

    // ───── Notas / juicios de evaluacion por aprendiz ──────────────────────
    // Las notas oficiales (A/D), importadas del Excel institucional, las escribe
    // SOLO el admin. El aprendiz puede LEER unicamente las suyas. Reemplaza el
    // antiguo archivo semilla publico data/grades_*.js, que exponia en el repo
    // publico los nombres y las notas de los aprendices (PII de menores).
    // Doc: { usernameKey, grades: { guideFamily: { actId: "A"|"D" } }, updatedAt }
    match /sena_portal_grades/{usernameKey} {
      allow read:  if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow write: if isAdmin();
    }

    // ───── Banco de respuestas modelo (SOLO admin) ─────────────────────────
    // El banco MAESTRO de soluciones por actividad NUNCA debe llegar al cliente
    // del aprendiz. Solo el admin lo lee/escribe. Al APROBAR, el admin copia la
    // solucion puntual dentro del doc de notas del aprendiz (sena_portal_grades),
    // que el aprendiz si puede leer (solo la suya). Asi el aprendiz ve unicamente
    // la respuesta de su propia actividad aprobada, jamas el banco completo.
    // Doc unico "bank": { solutions: { guideFamily: { actId: { "<data-store>": "texto" } } }, updatedAt }
    match /sena_portal_grade_solutions/{docId} {
      allow read, write: if isAdmin();
    }

    // ───── Planes de mejoramiento (remediacion por aprendiz) ───────────────
    // El instructor (admin) asigna un plan a un aprendiz que no entrego a tiempo:
    // re-habilita la actividad con motivo + nueva fecha, y queda como evidencia.
    // El admin escribe; el aprendiz LEE solo el suyo (mismo patron que las notas).
    // Doc: { usernameKey, plans: [ { id, family, guideFile, activityId, motivo,
    //   fechaAsignacion, fechaLimite, historialFechas, asignadoPor, estado,
    //   entrega, resultado, resultadoEn } ], updatedAt }
    match /sena_portal_improvement_plans/{usernameKey} {
      allow read:  if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow write: if isAdmin();
    }

    // ───── Talleres de refuerzo (documento de refuerzo asignado por el
    // instructor a uno o varios aprendices, NO ligado a una actividad real de
    // una guia) ──────────────────────────────────────────────────────────────
    // El admin escribe; el aprendiz LEE solo el suyo (mismo patron que los
    // planes de mejoramiento y las notas).
    // Doc: { usernameKey, workshops: [ { id, workshopKey, title, fileUrl,
    //   motivo, fechaAsignacion, fechaLimite, historialFechas, asignadoPor,
    //   estado, entrega, resultado, resultadoEn } ], updatedAt }
    match /sena_portal_reinforcement_workshops/{usernameKey} {
      allow read:  if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow write: if isAdmin();
    }

    // ───── Respuestas de talleres de refuerzo (el aprendiz SI escribe) ─────
    // Separado a proposito del doc de arriba: ese guarda datos AUTORITATIVOS
    // (fechaLimite, estado, resultado) que solo el admin puede escribir -- si
    // el aprendiz pudiera escribir el mismo doc, podria forjar su propio
    // "Superado" y enganar al admin (no solo a si mismo, ver Trust model en
    // CLAUDE.md). Aqui SOLO viven las respuestas de texto de las actividades,
    // sin ningun campo de calificacion, por eso el aprendiz si puede escribir
    // la suya (mismo patron que sena_portal_progress).
    // Doc: { usernameKey, answers: { [workshopId]: {...respuestas} }, updatedAt }
    match /sena_portal_reinforcement_answers/{usernameKey} {
      allow read, write: if isAdmin() || isOwnerByUsernameKey(usernameKey);
    }

    // ───── Estado de guias (un doc por aprendiz x guia) ────────────────────
    // Fallback de sena_portal_progress (saveGuideStateDoc en firebase_db.js
    // cae aqui SOLO si el PATCH a progress fallo por algo que no fue un
    // conflicto de version). Usa el MISMO docId compuesto que progress
    // (__guide_data__/__guide_ui__:student|uid:...), nunca un usernameKey
    // simple -- por eso la propiedad se verifica igual que en progress, por
    // el segmento del docId, y NO por un campo del documento.
    //
    // Corregido (auditoria profunda): la version anterior de esta regla
    // exigia un campo `usernameKey` EN EL DOCUMENTO para autorizar al dueno,
    // pero el codigo SIEMPRE escribia `_usernameKey` (con guion bajo) --
    // ademas, aunque el nombre hubiera coincidido, el VALOR que se escribia
    // ahi era el docId COMPUESTO completo, no un usernameKey suelto, asi que
    // isOwnerByUsernameKey tampoco lo habria reconocido jamas. Resultado
    // confirmado: la creacion de este fallback SIEMPRE devolvia 403 para un
    // aprendiz (nunca para el admin, que entra por isAdmin()), y fsPatch
    // (firebase_db.js) trata un 403 como "auth rejection" -> lo redirige en
    // silencio al respaldo de Drive (ver isAuthRejection/driveFallbackSet).
    // O sea: si, este desajuste SI forzaba caida a Drive para esta escritura
    // puntual -- confirmado leyendo el flujo completo, no solo el nombre del
    // campo. guideStateOwnerKey() se conserva como camino de compatibilidad
    // adicional para cualquier doc antiguo real que exista con un usernameKey
    // suelto (con o sin guion bajo) en vez de un docId compuesto.
    function guideStateOwnerKey(data) {
      return data.usernameKey != null ? data.usernameKey : data._usernameKey;
    }
    function isOwnerOfGuideStateDoc(docId, data) {
      return isOwnerOfComposedStudentDoc(docId)
        || isOwnerOfComposedUidDoc(docId)
        || (guideStateOwnerKey(data) != null && isOwnerByUsernameKey(guideStateOwnerKey(data)));
    }
    match /sena_portal_guide_state/{docId} {
      // Fallback del doc compartido de fechas: misma lectura compartida que en progress.
      allow get: if signedIn() && isSharedDeadlinesDoc(docId);
      allow read: if isAdmin()
        || (signedIn() && isOwnerOfGuideStateDoc(docId, resource.data));
      allow create: if isAdmin()
        || (signedIn() && isOwnerOfGuideStateDoc(docId, request.resource.data));
      allow update: if isAdmin()
        || (
          signedIn()
          && isOwnerOfGuideStateDoc(docId, resource.data)
          && isOwnerOfGuideStateDoc(docId, request.resource.data)
        );
      allow delete: if isAdmin();
    }

    // ───── Calendario academico ────────────────────────────────────────────
    // Lectura para cualquier sesion autenticada, escritura solo admin.
    match /sena_portal_calendar/{calendarId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ───── Reservas de tutoria ─────────────────────────────────────────────
    // Lectura para cualquier sesion autenticada. El aprendiz solo puede crear,
    // editar o borrar la reserva cuyo usernameKey coincide con su sesion.
    match /sena_portal_tutoring_bookings/{bookingId} {
      function tutoringDocId(data) {
        return data.date + "__" + data.ficha + "__" + data.usernameKey;
      }

      function isTutoringOwnerOfRequest() {
        return signedIn()
          && request.resource.data.usernameKey is string
          && request.resource.data.date is string
          && request.resource.data.ficha is string
          && isOwnerByUsernameKey(request.resource.data.usernameKey)
          && tutoringDocId(request.resource.data) == bookingId;
      }

      function isTutoringOwnerOfResource() {
        return signedIn()
          && resource.data.usernameKey is string
          && isOwnerByUsernameKey(resource.data.usernameKey);
      }

      function isValidTutoringBooking() {
        return request.resource.data.keys().hasOnly([
          "date",
          "ficha",
          "grupo",
          "inst",
          "startTime",
          "endTime",
          "durationMinutes",
          "usernameKey",
          "studentName",
          "topic",
          "createdAt",
          "updatedAt"
        ])
          && request.resource.data.date is string
          && request.resource.data.date.matches("^20[0-9]{2}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.ficha is string
          && request.resource.data.ficha.matches("^[0-9]{6,8}$")
          && request.resource.data.startTime in [
            "14:00", "14:30", "15:00", "15:30",
            "16:00", "16:30", "17:00", "17:30"
          ]
          && request.resource.data.endTime in [
            "14:30", "15:00", "15:30", "16:00",
            "16:30", "17:00", "17:30", "18:00"
          ]
          && request.resource.data.durationMinutes in [30, 60]
          && request.resource.data.usernameKey is string
          && request.resource.data.usernameKey.matches("^[a-z0-9._-]{3,30}$")
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() <= 120
          && (!("topic" in request.resource.data)
            || (request.resource.data.topic is string
              && request.resource.data.topic.size() <= 120));
      }

      // Corregido (auditoria profunda, Fase 7): antes "if signedIn()" dejaba
      // leer la reserva de CUALQUIER aprendiz de CUALQUIER ficha (nombre
      // completo, tema, horario) con solo tener sesion. El aprendiz SI
      // necesita ver las reservas de su PROPIA ficha (para saber que horarios
      // ya estan ocupados al agendar, ver cloudListTutoringBookingsForDate en
      // firebase_db.js) -- por eso no se restringe a "solo la propia", sino a
      // "misma ficha minima" (mismo patron que requesterFicha() ya usado en
      // sena_portal_users). Nunca una ficha ajena.
      allow read: if isAdmin()
        || isTutoringOwnerOfResource()
        || (signedIn() && resource.data.ficha == requesterFicha());
      allow create: if isValidTutoringBooking()
        && (isAdmin() || isTutoringOwnerOfRequest());
      allow update: if isAdmin()
        || (isValidTutoringBooking()
          && isTutoringOwnerOfResource()
          && isTutoringOwnerOfRequest());
      allow delete: if isAdmin() || isTutoringOwnerOfResource();
    }

    // ───── Autorizacion de uso de firma (evidencia de consentimiento) ──────
    // El aprendiz sube una foto/escaneo de su firma autografa para autorizar
    // al instructor a usarla en documentacion institucional del SENA. El
    // archivo va a Drive (Apps Script); este doc es solo el REGISTRO/control
    // de quien ya autorizo. El aprendiz puede leer y crear/actualizar SU
    // propio registro, pero una vez queda status=="delivered" (ya envio),
    // solo el admin puede volver a escribir (re-habilitar para un reenvio).
    // Doc: { usernameKey, fullName, ficha, institucion, submittedAt,
    //   fileName, driveUrl, status: "delivered"|"", updatedAt }
    match /sena_portal_signature_auth/{usernameKey} {
      allow read: if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow create: if isAdmin() || isOwnerByUsernameKey(usernameKey);
      allow update: if isAdmin()
        || (isOwnerByUsernameKey(usernameKey) && resource.data.status != "delivered");
      allow delete: if isAdmin();
    }

    // ───── Equipos de trabajo (grupos colaborativos) ───────────────────────
    // Cada doc representa un equipo de 3-4 aprendices que entrega una
    // actividad en conjunto (p. ej. portafolio Actividad 10 de Guia 2).
    // El doc almacena la lista de emails sinteticos de los miembros para que
    // las reglas puedan validar pertenencia sin Custom Claims.
    function isGroupMemberOfResource() {
      return signedIn()
        && resource.data.memberEmails is list
        && resource.data.memberEmails.hasAny([request.auth.token.email]);
    }
    function isGroupMemberOfRequest() {
      return signedIn()
        && request.resource.data.memberEmails is list
        && request.resource.data.memberEmails.hasAny([request.auth.token.email]);
    }
    match /sena_portal_groups/{groupId} {
      allow read: if isAdmin() || isGroupMemberOfResource();
      allow create: if isAdmin() || isGroupMemberOfRequest();
      allow update: if isAdmin()
        || (isGroupMemberOfResource() && isGroupMemberOfRequest());
      allow delete: if isAdmin();
    }

    // ───── Default: cierre total ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
